{
  "name": "greenflag",
  "version": "0.1.6",
  "description": "Opinionated blocks for AI coding workflows — spec loops, adversarial review, an autonomous build. Run it AFK with human gates.",
  "keywords": [
    "ai",
    "agents",
    "orchestrator",
    "claude",
    "codex",
    "workflow",
    "cli"
  ],
  "license": "MIT",
  "author": "qiushiyan <qiushi.yann@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiushiyan/greenflag.git"
  },
  "homepage": "https://github.com/qiushiyan/greenflag#readme",
  "bugs": "https://github.com/qiushiyan/greenflag/issues",
  "type": "module",
  "bin": {
    "greenflag": "src/surfaces/cli.ts"
  },
  "exports": {
    "./workflows": {
      "types": "./dist/workflows.d.mts",
      "import": "./dist/workflows.mjs"
    }
  },
  "publishConfig": {
    "bin": {
      "greenflag": "dist/cli.mjs"
    }
  },
  "files": [
    "dist",
    "snippets",
    "skills",
    "lessons",
    "prompts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "greenflag": "node src/surfaces/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-skills": "node scripts/sync-skills.mjs",
    "vendor-lessons": "node scripts/vendor-lessons.mjs",
    "build": "tsdown",
    "release": "changeset publish",
    "prepack": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "node scripts/guard-publish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/codex-sdk": "^0.133.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.1",
    "xstate": "^5.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^25.9.2",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
