{
  "id": "greenflag",
  "initial": "route",
  "states": {
    "route": {
      "always": [
        {
          "target": "researchLoop"
        }
      ]
    },
    "researchLoop": {
      "tags": [
        "phase"
      ],
      "invoke": {
        "src": "phaseDriver",
        "onError": {
          "target": "researchFlagWait"
        }
      },
      "on": {
        "phase.advance": {
          "target": "directionGate"
        },
        "phase.flag": {
          "target": "researchFlagWait"
        }
      }
    },
    "researchFlagWait": {
      "tags": [
        "quiescent",
        "flag-wait"
      ],
      "on": {
        "human.answer": {
          "target": "researchLoop"
        }
      }
    },
    "directionGate": {
      "tags": [
        "quiescent",
        "gate"
      ],
      "on": {
        "human.approve": {
          "target": "implementLoop"
        },
        "human.reject": {
          "target": "researchLoop"
        }
      }
    },
    "implementLoop": {
      "tags": [
        "phase"
      ],
      "invoke": {
        "src": "phaseDriver",
        "onError": {
          "target": "implementFlagWait"
        }
      },
      "on": {
        "phase.advance": {
          "target": "shipGate"
        },
        "phase.flag": {
          "target": "implementFlagWait"
        }
      }
    },
    "implementFlagWait": {
      "tags": [
        "quiescent",
        "flag-wait"
      ],
      "on": {
        "human.answer": {
          "target": "implementLoop"
        }
      }
    },
    "shipGate": {
      "tags": [
        "quiescent",
        "gate"
      ],
      "on": {
        "human.approve": {
          "target": "finishLoop"
        },
        "human.reject": {
          "target": "implementLoop"
        }
      }
    },
    "finishLoop": {
      "tags": [
        "phase"
      ],
      "invoke": {
        "src": "phaseDriver",
        "onError": {
          "target": "finishFlagWait"
        }
      },
      "on": {
        "phase.advance": {
          "target": "openPrGate"
        },
        "phase.flag": {
          "target": "finishFlagWait"
        }
      }
    },
    "finishFlagWait": {
      "tags": [
        "quiescent",
        "flag-wait"
      ],
      "on": {
        "human.answer": {
          "target": "finishLoop"
        }
      }
    },
    "openPrGate": {
      "tags": [
        "quiescent",
        "gate"
      ],
      "on": {
        "human.approve": {
          "target": "done"
        },
        "human.reject": {
          "target": "finishLoop"
        }
      }
    },
    "done": {
      "type": "final",
      "tags": [
        "quiescent"
      ]
    }
  }
}